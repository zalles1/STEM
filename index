<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>STEM English Lab</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
:root{
--bg:#080d16;--bg2:#0e1525;--card:#131f33;--card2:#182942;
--border:#1e3355;--fg:#e6ecf5;--muted:#7189aa;
--em:#10b981;--em-d:rgba(16,185,129,.12);
--cy:#06b6d4;--cy-d:rgba(6,182,212,.12);
--am:#f59e0b;--am-d:rgba(245,158,11,.12);
--ro:#f43f5e;--ro-d:rgba(244,63,94,.12);
--vi:#8b5cf6;--vi-d:rgba(139,92,246,.12);
--ok:#10b981;--ok-d:rgba(16,185,129,.14);
--no:#f43f5e;--no-d:rgba(244,63,94,.14);
--wr:#f59e0b;--wr-d:rgba(245,158,11,.14)
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Space Grotesk',sans-serif;background:var(--bg);color:var(--fg);min-height:100vh;overflow-x:hidden}
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

/* ===== FONDO ===== */
.bg-mesh{position:fixed;inset:0;z-index:0;pointer-events:none;
background:
  radial-gradient(ellipse 600px 400px at 15% 20%,rgba(16,185,129,.07),transparent),
  radial-gradient(ellipse 500px 500px at 85% 80%,rgba(6,182,212,.06),transparent),
  radial-gradient(ellipse 400px 300px at 50% 50%,rgba(139,92,246,.04),transparent)}
.bg-grid{position:fixed;inset:0;z-index:0;pointer-events:none;
background-image:linear-gradient(rgba(16,185,129,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(16,185,129,.018) 1px,transparent 1px);
background-size:55px 55px;animation:gm 50s linear infinite}
@keyframes gm{to{transform:translate(55px,55px)}}
.bg-orb{position:fixed;border-radius:50%;filter:blur(100px);opacity:.08;pointer-events:none;z-index:0;animation:orbFloat 20s ease-in-out infinite}
.orb1{width:400px;height:400px;top:-100px;left:-80px;background:var(--em)}
.orb2{width:350px;height:350px;bottom:-120px;right:-60px;background:var(--cy)}
.orb3{width:250px;height:250px;top:50%;left:40%;background:var(--vi);animation-delay:-10s}
@keyframes orbFloat{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(30px,-20px) scale(1.05)}66%{transform:translate(-20px,15px) scale(.95)}}

/* ===== HEADER ===== */
header{position:sticky;top:0;z-index:100;background:rgba(8,13,22,.92);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);padding:0 1rem}
.hdr{max-width:1320px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:56px;gap:8px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:9px;font-weight:700;font-size:1.1rem;letter-spacing:-.4px;white-space:nowrap}
.logo-i{width:32px;height:32px;background:linear-gradient(135deg,var(--em),var(--cy));border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:.85rem;color:var(--bg);font-weight:800}
.logo em{font-style:normal;color:var(--em)}
.hstats{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.hb{display:flex;align-items:center;gap:4px;font-size:.7rem;color:var(--muted);padding:4px 10px;background:var(--card);border-radius:16px;border:1px solid var(--border)}
.hb i{font-size:.68rem}.hb .v{color:var(--fg);font-weight:700;font-family:'JetBrains Mono',monospace}
.author{font-size:.55rem;color:var(--muted);padding:3px 9px;background:linear-gradient(135deg,var(--vi-d),var(--cy-d));border-radius:12px;border:1px solid rgba(139,92,246,.15);line-height:1.3;text-align:center}
.author b{color:var(--cy);display:block;font-size:.5rem;text-transform:uppercase;letter-spacing:.8px}

/* ===== NAV ===== */
nav.tabs{position:relative;z-index:10;max-width:1320px;margin:1rem auto 0;padding:0 1rem;display:flex;gap:3px;overflow-x:auto}
.tb{flex:1;min-width:0;padding:10px 5px;background:var(--card);border:1px solid var(--border);border-radius:10px 10px 0 0;color:var(--muted);font-family:'Space Grotesk',sans-serif;font-size:.7rem;font-weight:500;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;transition:all .25s;border-bottom:3px solid transparent;white-space:nowrap}
.tb i{font-size:.95rem}.tb:hover{background:var(--card2);color:var(--fg)}
.tb.on{background:var(--bg2);color:var(--em);border-bottom-color:var(--em)}
.tb small{font-size:.5rem;text-transform:uppercase;letter-spacing:.8px;opacity:.45}

/* ===== MAIN ===== */
main{position:relative;z-index:10;max-width:1320px;margin:0 auto;padding:0 1rem 2rem}
.pnl{display:none;background:var(--bg2);border:1px solid var(--border);border-top:none;border-radius:0 0 14px 14px;padding:1.5rem;animation:fi .35s ease}
.pnl.on{display:block}
@keyframes fi{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* ===== SUBTABS ===== */
.stabs{display:flex;gap:3px;margin-bottom:1.25rem;background:var(--card);padding:4px;border-radius:10px;border:1px solid var(--border);overflow-x:auto}
.stab{padding:7px 13px;border:none;border-radius:8px;font-family:'Space Grotesk',sans-serif;font-size:.72rem;font-weight:500;cursor:pointer;background:transparent;color:var(--muted);transition:all .2s;display:flex;align-items:center;gap:5px;white-space:nowrap}
.stab:hover{color:var(--fg)}.stab.on{background:var(--em);color:var(--bg);font-weight:600}
.scont{display:none;animation:fi .3s}.scont.on{display:block}

/* ===== SECTION HEADER ===== */
.sh{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.25rem;flex-wrap:wrap;gap:.7rem}
.stitle{font-size:1.35rem;font-weight:800;letter-spacing:-.6px;background:linear-gradient(135deg,var(--fg),var(--muted));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.stitle small{display:block;font-size:.7rem;font-weight:400;margin-top:3px;letter-spacing:0;-webkit-text-fill-color:var(--muted)}
.dsel{display:flex;gap:2px;background:var(--card);padding:3px;border-radius:9px;border:1px solid var(--border);flex-wrap:wrap}
.db{padding:5px 10px;border:none;border-radius:7px;font-family:'JetBrains Mono',monospace;font-size:.65rem;font-weight:700;cursor:pointer;background:transparent;color:var(--muted);transition:all .2s;letter-spacing:.5px}
.db:hover{color:var(--fg)}.db.on{background:var(--em);color:var(--bg);box-shadow:0 2px 8px rgba(16,185,129,.3)}

/* ===== READING ===== */
.rpass{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.25rem;margin-bottom:1.25rem;line-height:1.85;font-size:.88rem;color:#a8bdd6;max-height:260px;overflow-y:auto;position:relative}
.vh{color:var(--em);cursor:pointer;border-bottom:1px dashed var(--em);transition:all .2s}.vh:hover{background:var(--em-d);border-radius:3px}
.vtt{position:fixed;background:var(--card2);border:1px solid var(--em);border-radius:10px;padding:10px 13px;font-size:.78rem;color:var(--fg);z-index:1000;pointer-events:none;opacity:0;transition:opacity .15s;max-width:260px;box-shadow:0 8px 32px rgba(0,0,0,.5)}
.vtt.show{opacity:1}.vtt .vw{color:var(--em);font-weight:700}.vtt .vd{color:var(--muted);margin-top:3px;font-size:.72rem}

/* ===== QUESTIONS ===== */
.qgrid{display:grid;gap:.75rem}
.qc{background:var(--card);border:1px solid var(--border);border-radius:11px;padding:1.1rem;transition:all .3s}
.qc.ok{border-color:var(--ok);background:var(--ok-d)}.qc.no{border-color:var(--no);background:var(--no-d)}
.qn{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--em);font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:5px}
.qt{font-size:.85rem;margin-bottom:9px;line-height:1.5}
.qops{display:grid;grid-template-columns:1fr 1fr;gap:5px}
@media(max-width:600px){.qops{grid-template-columns:1fr}}
.qo{padding:8px 11px;background:rgba(255,255,255,.015);border:1px solid var(--border);border-radius:8px;cursor:pointer;font-size:.8rem;color:#8da4c4;transition:all .2s;font-family:'Space Grotesk',sans-serif;text-align:left}
.qo:hover:not(.dis){background:var(--em-d);border-color:var(--em);color:var(--fg)}
.qo.sel{background:var(--em-d);border-color:var(--em);color:var(--em);font-weight:500}
.qo.dis{pointer-events:none;opacity:.5}
.qo.ca{background:var(--ok-d)!important;border-color:var(--ok)!important;color:var(--ok)!important;opacity:1!important;font-weight:600}
.qo.wa{background:var(--no-d)!important;border-color:var(--no)!important;color:var(--no)!important;opacity:1!important}
.qfb{margin-top:7px;font-size:.75rem;padding:7px 10px;border-radius:7px;display:none;line-height:1.5}
.qfb.show{display:block}
.qfb.fok{background:var(--ok-d);color:var(--ok)}.qfb.fno{background:var(--no-d);color:var(--no)}

/* ===== GAP ===== */
.gap-s{font-size:.9rem;line-height:2.2;color:#a8bdd6;margin-bottom:.75rem;padding:1.1rem;background:var(--card);border-radius:11px;border:1px solid var(--border)}
.gi{display:inline-block;min-width:90px;padding:4px 10px;background:var(--card2);border:1px solid var(--border);border-radius:6px;color:var(--fg);font-family:'JetBrains Mono',monospace;font-size:.84rem;outline:none;text-align:center;transition:all .2s;vertical-align:middle}
.gi:focus{border-color:var(--em);box-shadow:0 0 0 2px var(--em-d)}
.gi.ok{border-color:var(--ok);background:var(--ok-d);color:var(--ok)}.gi.no{border-color:var(--no);background:var(--no-d);color:var(--no)}
.gi::placeholder{color:var(--muted);font-size:.7rem}

/* ===== MATCHING ===== */
.mgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:600px){.mgrid{grid-template-columns:1fr}}
.mcol{display:flex;flex-direction:column;gap:6px}
.mitem{padding:11px 14px;background:var(--card);border:2px solid var(--border);border-radius:9px;cursor:pointer;font-size:.84rem;transition:all .25s;user-select:none}
.mitem:hover{border-color:var(--cy);transform:translateY(-1px)}
.mitem.sel{border-color:var(--em);background:var(--em-d);color:var(--em);font-weight:500}
.mitem.done{border-color:var(--ok);background:var(--ok-d);color:var(--ok);pointer-events:none;opacity:.65}
.mitem.wm{border-color:var(--no);background:var(--no-d);color:var(--no);animation:shake .4s}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}

/* ===== TRUE/FALSE ===== */
.tf-g{display:flex;gap:8px;align-items:center}
.tfb{padding:9px 22px;border:1px solid var(--border);border-radius:8px;cursor:pointer;font-size:.84rem;font-family:'Space Grotesk',sans-serif;transition:all .2s;background:rgba(255,255,255,.015);color:var(--muted);font-weight:500}
.tfb:hover{border-color:var(--cy);color:var(--cy)}
.tfb.sel{border-color:var(--em);color:var(--em);background:var(--em-d)}
.tfb.cat{border-color:var(--ok)!important;color:var(--ok)!important;background:var(--ok-d)!important}
.tfb.wat{border-color:var(--no)!important;color:var(--no)!important;background:var(--no-d)!important}

/* ===== SHORT ANSWER ===== */
.sai{width:100%;padding:10px 14px;background:var(--card2);border:1px solid var(--border);border-radius:8px;color:var(--fg);font-family:'Space Grotesk',sans-serif;font-size:.85rem;outline:none;transition:border-color .2s}
.sai:focus{border-color:var(--em);box-shadow:0 0 0 2px var(--em-d)}.sai::placeholder{color:var(--muted)}

/* ===== SCRAMBLE ===== */
.scr-w{display:flex;gap:7px;justify-content:center;flex-wrap:wrap;margin:1rem 0}
.scr-l{width:40px;height:44px;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,var(--card2),var(--card));border:1px solid var(--border);border-radius:8px;font-size:1.15rem;font-weight:800;color:var(--em);font-family:'JetBrains Mono',monospace;cursor:pointer;transition:all .25s}
.scr-l:hover{border-color:var(--em);transform:translateY(-3px);box-shadow:0 4px 12px rgba(16,185,129,.2)}
.scr-l.pl{opacity:.25;pointer-events:none;transform:scale(.9)}
.scr-a{display:flex;gap:5px;justify-content:center;min-height:48px;padding:10px;background:var(--card);border:2px dashed var(--border);border-radius:10px;margin:1rem 0;flex-wrap:wrap}
.scr-sl{width:36px;height:40px;border:1px dashed var(--border);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:1.05rem;font-weight:800;color:var(--fg);font-family:'JetBrains Mono',monospace;transition:all .2s}
.scr-sl.fil{border-style:solid;border-color:var(--em);background:var(--em-d);color:var(--em)}

/* ===== DICTATION ===== */
.dbox{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.25rem;margin-bottom:.75rem}
.dplay{width:48px;height:48px;border-radius:50%;border:2px solid var(--cy);background:var(--cy-d);color:var(--cy);font-size:1.1rem;cursor:pointer;transition:all .25s;display:inline-flex;align-items:center;justify-content:center}
.dplay:hover{background:rgba(6,182,212,.2);transform:scale(1.06);box-shadow:0 4px 16px rgba(6,182,212,.25)}
.dplay.pl2{background:var(--cy);color:var(--bg);animation:dpulse 1.2s ease infinite}
@keyframes dpulse{0%,100%{box-shadow:0 0 0 0 rgba(6,182,212,.35)}50%{box-shadow:0 0 0 14px rgba(6,182,212,0)}}

/* ===== LISTENING WORDS ===== */
.lex{background:var(--card);border:1px solid var(--border);border-radius:13px;padding:1.25rem;margin-bottom:.75rem}
.lsbox{display:flex;align-items:center;gap:10px;margin-bottom:.75rem;padding:12px;background:var(--card2);border-radius:9px;border:1px solid var(--border)}
.wgrid{display:flex;flex-wrap:wrap;gap:7px;justify-content:center;margin:.75rem 0}
.wchip{padding:8px 15px;border:1px solid var(--border);border-radius:8px;font-size:.86rem;font-weight:500;cursor:pointer;transition:all .2s;background:rgba(255,255,255,.015);color:#8da4c4;font-family:'JetBrains Mono',monospace;user-select:none}
.wchip:hover{border-color:var(--cy);color:var(--cy);background:var(--cy-d)}
.wchip.sel{background:var(--em-d);border-color:var(--em);color:var(--em)}
.wchip.cw{background:var(--ok-d);border-color:var(--ok);color:var(--ok)}
.wchip.ww{background:var(--no-d);border-color:var(--no);color:var(--no)}
.wchip.mw{background:var(--wr-d);border-color:var(--wr);color:var(--wr);opacity:.55}
.lnav{display:flex;align-items:center;justify-content:center;gap:.75rem;margin-top:.75rem}
.lnav button{width:34px;height:34px;border-radius:50%;border:1px solid var(--border);background:var(--card);color:var(--fg);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;font-size:.78rem}
.lnav button:hover{border-color:var(--cy);color:var(--cy)}
.lctr{font-family:'JetBrains Mono',monospace;font-size:.8rem;color:var(--muted)}

/* ===== AUDIO CARD ===== */
.aucard{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.5rem;text-align:center;margin-bottom:1rem}
.auvis{width:100px;height:100px;margin:0 auto .75rem;border-radius:50%;background:var(--cy-d);border:2px solid var(--cy);display:flex;align-items:center;justify-content:center;position:relative;transition:all .3s;cursor:pointer}
.auvis.playing{animation:apulse 1.5s ease-in-out infinite;box-shadow:0 0 35px rgba(6,182,212,.2)}
@keyframes apulse{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
.auvis i{font-size:1.9rem;color:var(--cy)}.auvis .ring{position:absolute;inset:-8px;border-radius:50%;border:1px solid rgba(6,182,212,.12)}
.auctrls{display:flex;justify-content:center;gap:8px;margin-bottom:.5rem}
.abtn{width:40px;height:40px;border-radius:50%;border:1px solid var(--border);background:var(--card);color:var(--fg);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.88rem;transition:all .2s}
.abtn:hover{border-color:var(--cy);color:var(--cy);background:var(--cy-d)}
.pbar{width:100%;height:4px;background:var(--border);border-radius:2px;overflow:hidden;margin-top:8px}
.pbar-f{height:100%;background:linear-gradient(90deg,var(--cy),var(--em));border-radius:2px;transition:width .5s ease}
.tbox{background:var(--card);border:1px solid var(--border);border-radius:11px;padding:0;margin-bottom:1rem;max-height:0;overflow:hidden;transition:all .4s;opacity:0}
.tbox.show{max-height:320px;opacity:1;padding:1rem;overflow-y:auto}
.tbox p{line-height:1.8;font-size:.85rem;color:#8da4c4}

/* ===== WRITING ===== */
.wprompt{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.25rem;margin-bottom:1.25rem;border-left:3px solid var(--em)}
.plbl{font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:var(--em);margin-bottom:6px}
.ptxt{font-size:.94rem;line-height:1.65;color:var(--fg)}
.wkws{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px}
.kwt{padding:3px 10px;background:var(--em-d);border:1px solid rgba(16,185,129,.15);border-radius:5px;font-size:.7rem;color:var(--em);font-family:'JetBrains Mono',monospace}
.warea{width:100%;min-height:170px;background:var(--card);border:1px solid var(--border);border-radius:11px;padding:1.1rem;color:var(--fg);font-family:'Space Grotesk',sans-serif;font-size:.9rem;line-height:1.75;resize:vertical;outline:none;transition:border-color .3s}
.warea:focus{border-color:var(--em);box-shadow:0 0 0 3px var(--em-d)}.warea::placeholder{color:var(--muted)}
.wstats{display:flex;gap:1.2rem;margin-top:7px;font-size:.7rem;color:var(--muted);font-family:'JetBrains Mono',monospace}
.wstats strong{color:var(--fg)}
.wfb{background:var(--card);border:1px solid var(--border);border-radius:11px;padding:1.1rem;margin-top:1rem;display:none;border-left:3px solid var(--am)}
.wfb.show{display:block;animation:fi .3s}
.wfb h4{font-size:.82rem;color:var(--am);margin-bottom:9px;display:flex;align-items:center;gap:6px}
.fbi{display:flex;align-items:flex-start;gap:7px;padding:7px 0;border-bottom:1px solid var(--border);font-size:.8rem;color:#8da4c4;line-height:1.5}
.fbi:last-child{border-bottom:none}.fbi i{margin-top:2px;font-size:.75rem}
.fg{color:var(--ok)}.fw{color:var(--wr)}.fb2{color:var(--no)}

/* ===== SPEAKING ===== */
.spkcard{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.5rem;text-align:center;margin-bottom:1rem}
.spkw{font-size:1.8rem;font-weight:800;color:var(--fg);margin-bottom:4px;letter-spacing:-.5px}
.spkph{font-family:'JetBrains Mono',monospace;font-size:.86rem;color:var(--cy);margin-bottom:2px}
.spkm{font-size:.82rem;color:var(--muted)}
.spkctx{margin-top:10px;font-size:.82rem;color:#6a80a0;font-style:italic}
.lmod{padding:7px 14px;background:transparent;border:1px solid var(--cy);border-radius:7px;color:var(--cy);font-family:'Space Grotesk',sans-serif;font-size:.76rem;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:5px;margin-top:10px}
.lmod:hover{background:var(--cy-d);box-shadow:0 2px 10px rgba(6,182,212,.2)}
.mbtn{width:72px;height:72px;border-radius:50%;border:2px solid var(--em);background:var(--em-d);color:var(--em);font-size:1.7rem;cursor:pointer;transition:all .3s;margin:.75rem auto;display:flex;align-items:center;justify-content:center}
.mbtn:hover{background:rgba(16,185,129,.18);transform:scale(1.05);box-shadow:0 4px 20px rgba(16,185,129,.2)}
.mbtn.rec{background:var(--em);color:var(--bg);animation:mpulse 1s ease infinite}
@keyframes mpulse{0%,100%{box-shadow:0 0 0 0 rgba(16,185,129,.35)}50%{box-shadow:0 0 0 18px rgba(16,185,129,0)}}
.rres{background:var(--card);border:1px solid var(--border);border-radius:11px;padding:1.1rem;margin-top:.75rem;display:none}
.rres.show{display:block;animation:fi .3s}
.rres .rl2{font-size:.6rem;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:4px}
.rres .rt2{font-size:1.05rem;font-weight:600;color:var(--fg);margin-bottom:7px}
.mind{display:inline-flex;align-items:center;gap:5px;padding:4px 11px;border-radius:16px;font-size:.76rem;font-weight:600}
.mind.mg{background:var(--ok-d);color:var(--ok)}.mind.mp{background:var(--wr-d);color:var(--wr)}.mind.mr{background:var(--no-d);color:var(--no)}

/* ===== CHAT ===== */
.chcont{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden}
.chtopics{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:9px;padding:1rem;border-bottom:1px solid var(--border)}
