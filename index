<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>STEM English Lab</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
:root{--bg:#060b14;--bg2:#0c1219;--card:#111b28;--card2:#162035;--border:#1a2e4a;--fg:#e2e9f3;--muted:#6a80a0;--accent:#00e676;--accent2:#00bcd4;--adim:rgba(0,230,118,.1);--err:#ff5252;--edim:rgba(255,82,82,.12);--suc:#00e676;--sdim:rgba(0,230,118,.12);--wrn:#ffab00;--wdim:rgba(255,171,0,.1);--inf:#40c4ff;--idim:rgba(64,196,255,.1);--pur:#b388ff}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Space Grotesk',sans-serif;background:var(--bg);color:var(--fg);min-height:100vh;overflow-x:hidden}
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
.bg-grid{position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(0,230,118,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(0,230,118,.02) 1px,transparent 1px);background-size:50px 50px;animation:gm 40s linear infinite}
@keyframes gm{to{transform:translate(50px,50px)}}
.glow{position:fixed;border-radius:50%;filter:blur(140px);opacity:.1;pointer-events:none;z-index:0}
.g1{width:500px;height:500px;top:-150px;left:-100px;background:var(--accent)}
.g2{width:400px;height:400px;bottom:-180px;right:-120px;background:var(--accent2)}
.g3{width:300px;height:300px;top:50%;left:40%;background:var(--pur)}

header{position:sticky;top:0;z-index:100;background:rgba(6,11,20,.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:0 1rem}
.hdr{max-width:1300px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:54px;gap:8px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:8px;font-weight:700;font-size:1.05rem;letter-spacing:-.4px;white-space:nowrap}
.logo-ic{width:30px;height:30px;background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.8rem;color:var(--bg)}
.logo b{color:var(--accent)}
.hdr-stats{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.sb{display:flex;align-items:center;gap:4px;font-size:.72rem;color:var(--muted);padding:4px 9px;background:var(--card);border-radius:16px;border:1px solid var(--border)}
.sb i{font-size:.7rem}.sb .v{color:var(--fg);font-weight:600;font-family:'JetBrains Mono',monospace}
.author{font-size:.58rem;color:var(--muted);padding:3px 8px;background:var(--card);border-radius:12px;border:1px solid var(--border);line-height:1.2;text-align:center}
.author b{color:var(--accent2);display:block;font-size:.55rem;text-transform:uppercase;letter-spacing:.8px}

nav.tabs{position:relative;z-index:10;max-width:1300px;margin:1rem auto 0;padding:0 1rem;display:flex;gap:3px;overflow-x:auto}
.tb{flex:1;min-width:0;padding:10px 6px;background:var(--card);border:1px solid var(--border);border-radius:9px 9px 0 0;color:var(--muted);font-family:'Space Grotesk',sans-serif;font-size:.72rem;font-weight:500;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;transition:all .25s;border-bottom:3px solid transparent;white-space:nowrap}
.tb i{font-size:1rem}.tb:hover{background:var(--card2);color:var(--fg)}
.tb.on{background:var(--bg2);color:var(--accent);border-bottom-color:var(--accent)}
.tb small{font-size:.55rem;text-transform:uppercase;letter-spacing:.8px;opacity:.5}

main{position:relative;z-index:10;max-width:1300px;margin:0 auto;padding:0 1rem 2rem}
.pnl{display:none;background:var(--bg2);border:1px solid var(--border);border-top:none;border-radius:0 0 12px 12px;padding:1.25rem;animation:fi .3s ease}
.pnl.on{display:block}
@keyframes fi{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

.stabs{display:flex;gap:3px;margin-bottom:1rem;background:var(--card);padding:3px;border-radius:8px;border:1px solid var(--border);overflow-x:auto;flex-wrap:nowrap}
.stab{padding:7px 12px;border:none;border-radius:6px;font-family:'Space Grotesk',sans-serif;font-size:.72rem;font-weight:500;cursor:pointer;background:transparent;color:var(--muted);transition:all .2s;display:flex;align-items:center;gap:5px;white-space:nowrap}
.stab:hover{color:var(--fg)}.stab.on{background:var(--accent);color:var(--bg);font-weight:600}
.scont{display:none;animation:fi .3s}.scont.on{display:block}

.sh{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:.6rem}
.stitle{font-size:1.25rem;font-weight:700;letter-spacing:-.4px}
.stitle small{display:block;font-size:.7rem;color:var(--muted);font-weight:400;margin-top:3px}
.dsel{display:flex;gap:2px;background:var(--card);padding:3px;border-radius:8px;border:1px solid var(--border);flex-wrap:wrap}
.db{padding:4px 9px;border:none;border-radius:6px;font-family:'JetBrains Mono',monospace;font-size:.65rem;font-weight:600;cursor:pointer;background:transparent;color:var(--muted);transition:all .2s}
.db:hover{color:var(--fg)}.db.on{background:var(--accent);color:var(--bg)}

.rpass{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.1rem;margin-bottom:1rem;line-height:1.75;font-size:.85rem;color:#a8bad2;max-height:240px;overflow-y:auto}
.vh{color:var(--accent);cursor:pointer;border-bottom:1px dashed var(--accent);transition:all .2s}.vh:hover{background:var(--adim);border-radius:2px}
.vtt{position:fixed;background:var(--card2);border:1px solid var(--accent);border-radius:8px;padding:8px 11px;font-size:.75rem;color:var(--fg);z-index:1000;pointer-events:none;opacity:0;transition:opacity .15s;max-width:240px;box-shadow:0 6px 24px rgba(0,0,0,.5)}
.vtt.show{opacity:1}.vtt .vw{color:var(--accent);font-weight:600}.vtt .vd{color:var(--muted);margin-top:2px;font-size:.7rem}

.qgrid{display:grid;gap:.7rem}
.qc{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1rem;transition:all .3s}
.qc.ok{border-color:var(--suc);background:var(--sdim)}.qc.no{border-color:var(--err);background:var(--edim)}
.qn{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--accent);font-weight:700;text-transform:uppercase;letter-spacing:.8px;margin-bottom:5px}
.qt{font-size:.84rem;margin-bottom:8px;line-height:1.5}
.qops{display:grid;grid-template-columns:1fr 1fr;gap:5px}
@media(max-width:600px){.qops{grid-template-columns:1fr}}
.qo{padding:8px 10px;background:rgba(255,255,255,.02);border:1px solid var(--border);border-radius:7px;cursor:pointer;font-size:.8rem;color:#8da4c4;transition:all .2s;font-family:'Space Grotesk',sans-serif;text-align:left}
.qo:hover:not(.dis){background:var(--adim);border-color:var(--accent);color:var(--fg)}
.qo.sel{background:var(--adim);border-color:var(--accent);color:var(--accent)}
.qo.dis{pointer-events:none;opacity:.55}
.qo.ca{background:var(--sdim)!important;border-color:var(--suc)!important;color:var(--suc)!important;opacity:1!important}
.qo.wa{background:var(--edim)!important;border-color:var(--err)!important;color:var(--err)!important;opacity:1!important}
.qfb{margin-top:7px;font-size:.74rem;padding:6px 9px;border-radius:6px;display:none;line-height:1.4}
.qfb.show{display:block}
.qfb.fok{background:var(--sdim);color:var(--suc)}.qfb.fno{background:var(--edim);color:var(--err)}

/* Gap fill */
.gap-sentence{font-size:.9rem;line-height:2;color:#a8bad2;margin-bottom:1rem;padding:1rem;background:var(--card);border-radius:10px;border:1px solid var(--border)}
.gap-input{display:inline-block;min-width:80px;padding:3px 8px;background:var(--card2);border:1px solid var(--border);border-radius:5px;color:var(--fg);font-family:'JetBrains Mono',monospace;font-size:.82rem;outline:none;text-align:center;transition:border-color .2s;vertical-align:middle}
.gap-input:focus{border-color:var(--accent)}
.gap-input.ok{border-color:var(--suc);background:var(--sdim);color:var(--suc)}
.gap-input.no{border-color:var(--err);background:var(--edim);color:var(--err)}
.gap-input.hint{border-color:var(--wrn)}

/* Matching */
.match-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media(max-width:600px){.match-grid{grid-template-columns:1fr}}
.match-col{display:flex;flex-direction:column;gap:6px}
.match-item{padding:10px 12px;background:var(--card);border:2px solid var(--border);border-radius:8px;cursor:pointer;font-size:.82rem;transition:all .2s;user-select:none}
.match-item:hover{border-color:var(--accent2)}
.match-item.sel{border-color:var(--accent);background:var(--adim);color:var(--accent)}
.match-item.matched{border-color:var(--suc);background:var(--sdim);color:var(--suc);pointer-events:none;opacity:.7}
.match-item.wrong-match{border-color:var(--err);background:var(--edim);color:var(--err);animation:shake .4s}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}

/* Short answer */
.sa-input{width:100%;padding:10px 14px;background:var(--card2);border:1px solid var(--border);border-radius:8px;color:var(--fg);font-family:'Space Grotesk',sans-serif;font-size:.85rem;outline:none;transition:border-color .2s}
.sa-input:focus{border-color:var(--accent)}.sa-input::placeholder{color:var(--muted)}

/* True/False */
.tf-group{display:flex;gap:8px;align-items:center}
.tf-btn{padding:8px 18px;border:1px solid var(--border);border-radius:7px;cursor:pointer;font-size:.82rem;font-family:'Space Grotesk',sans-serif;transition:all .2s;background:rgba(255,255,255,.02);color:var(--muted)}
.tf-btn:hover{border-color:var(--accent2);color:var(--accent2)}
.tf-btn.sel{border-color:var(--accent);color:var(--accent);background:var(--adim)}
.tf-btn.ca-tf{border-color:var(--suc)!important;color:var(--suc)!important;background:var(--sdim)!important}
.tf-btn.wa-tf{border-color:var(--err)!important;color:var(--err)!important;background:var(--edim)!important}

/* Word scramble */
.scramble-word{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin:1rem 0}
.scr-letter{width:36px;height:40px;display:flex;align-items:center;justify-content:center;background:var(--card2);border:1px solid var(--border);border-radius:6px;font-size:1.1rem;font-weight:700;color:var(--accent);font-family:'JetBrains Mono',monospace;cursor:pointer;transition:all .2s}
.scr-letter:hover{border-color:var(--accent);transform:translateY(-2px)}
.scr-letter.placed{opacity:.3;pointer-events:none}
.scr-answer{display:flex;gap:4px;justify-content:center;min-height:44px;padding:8px;background:var(--card);border:1px dashed var(--border);border-radius:8px;margin:1rem 0;flex-wrap:wrap}
.scr-slot{width:32px;height:36px;border:1px dashed var(--border);border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:1rem;font-weight:700;color:var(--fg);font-family:'JetBrains Mono',monospace}
.scr-slot.filled{border-style:solid;border-color:var(--accent);background:var(--adim)}

/* Dictation */
.dict-box{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1rem;margin-bottom:1rem}
.dict-play{width:44px;height:44px;border-radius:50%;border:2px solid var(--accent2);background:rgba(0,188,212,.08);color:var(--accent2);font-size:1.1rem;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center}
.dict-play:hover{background:rgba(0,188,212,.15);transform:scale(1.05)}
.dict-play.playing{background:var(--accent2);color:var(--bg);animation:dpulse 1.2s ease infinite}
@keyframes dpulse{0%,100%{box-shadow:0 0 0 0 rgba(0,188,212,.3)}50%{box-shadow:0 0 0 10px rgba(0,188,212,0)}}

/* Listening words */
.lex{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.25rem;margin-bottom:.75rem}
.lsbox{display:flex;align-items:center;gap:10px;margin-bottom:.75rem;padding:12px;background:var(--card2);border-radius:8px;border:1px solid var(--border)}
.wgrid{display:flex;flex-wrap:wrap;gap:7px;justify-content:center;margin:.75rem 0}
.wchip{padding:7px 14px;border:1px solid var(--border);border-radius:7px;font-size:.84rem;font-weight:500;cursor:pointer;transition:all .2s;background:rgba(255,255,255,.02);color:#8da4c4;font-family:'JetBrains Mono',monospace;user-select:none}
.wchip:hover{border-color:var(--accent2);color:var(--accent2);background:rgba(0,188,212,.06)}
.wchip.sel{background:var(--adim);border-color:var(--accent);color:var(--accent)}
.wchip.cw{background:var(--sdim);border-color:var(--suc);color:var(--suc)}
.wchip.ww{background:var(--edim);border-color:var(--err);color:var(--err)}
.wchip.mw{background:var(--wdim);border-color:var(--wrn);color:var(--wrn);opacity:.6}
.lnav{display:flex;align-items:center;justify-content:center;gap:.75rem;margin-top:.75rem}
.lnav button{width:34px;height:34px;border-radius:50%;border:1px solid var(--border);background:var(--card);color:var(--fg);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;font-size:.8rem}
.lnav button:hover{border-color:var(--accent2);color:var(--accent2)}
.lctr{font-family:'JetBrains Mono',monospace;font-size:.78rem;color:var(--muted)}

/* Audio */
.aucard{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.25rem;text-align:center;margin-bottom:1rem}
.auvis{width:90px;height:90px;margin:0 auto .75rem;border-radius:50%;background:rgba(0,188,212,.06);border:2px solid var(--accent2);display:flex;align-items:center;justify-content:center;position:relative;transition:all .3s;cursor:pointer}
.auvis.playing{animation:apulse 1.5s ease-in-out infinite;box-shadow:0 0 30px rgba(0,188,212,.2)}
@keyframes apulse{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}
.auvis i{font-size:1.8rem;color:var(--accent2)}
.auvis .ring{position:absolute;inset:-7px;border-radius:50%;border:1px solid rgba(0,188,212,.12)}
.auctrls{display:flex;justify-content:center;gap:8px;margin-bottom:.5rem}
.abtn{width:38px;height:38px;border-radius:50%;border:1px solid var(--border);background:var(--card);color:var(--fg);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:all .2s}
.abtn:hover{border-color:var(--accent2);color:var(--accent2);background:rgba(0,188,212,.06)}
.pbar{width:100%;height:3px;background:var(--border);border-radius:2px;overflow:hidden;margin-top:6px}
.pbar-f{height:100%;background:linear-gradient(90deg,var(--accent2),var(--accent));border-radius:2px;transition:width .5s ease}
.tbox{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:0;margin-bottom:1rem;max-height:0;overflow:hidden;transition:all .4s;opacity:0}
.tbox.show{max-height:300px;opacity:1;padding:1rem;overflow-y:auto}
.tbox p{line-height:1.7;font-size:.84rem;color:#8da4c4}

/* Writing */
.wprompt{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.1rem;margin-bottom:1rem}
.plbl{font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:var(--accent);margin-bottom:6px}
.ptxt{font-size:.92rem;line-height:1.6;color:var(--fg)}
.wkws{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}
.kwt{padding:2px 8px;background:var(--adim);border:1px solid rgba(0,230,118,.15);border-radius:4px;font-size:.68rem;color:var(--accent);font-family:'JetBrains Mono',monospace}
.warea{width:100%;min-height:160px;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1rem;color:var(--fg);font-family:'Space Grotesk',sans-serif;font-size:.88rem;line-height:1.7;resize:vertical;outline:none;transition:border-color .3s}
.warea:focus{border-color:var(--accent)}.warea::placeholder{color:var(--muted)}
.wstats{display:flex;gap:1rem;margin-top:6px;font-size:.68rem;color:var(--muted);font-family:'JetBrains Mono',monospace}
.wstats strong{color:var(--fg)}
.wfb{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1rem;margin-top:.75rem;display:none}
.wfb.show{display:block;animation:fi .3s}
.wfb h4{font-size:.8rem;color:var(--accent);margin-bottom:8px;display:flex;align-items:center;gap:6px}
.fbi{display:flex;align-items:flex-start;gap:6px;padding:6px 0;border-bottom:1px solid var(--border);font-size:.78rem;color:#8da4c4;line-height:1.4}
.fbi:last-child{border-bottom:none}.fbi i{margin-top:2px;font-size:.72rem}
.fg{color:var(--suc)}.fw{color:var(--wrn)}.fb2{color:var(--err)}

/* Speaking */
.spkcard{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.25rem;text-align:center;margin-bottom:1rem}
.spkw{font-size:1.6rem;font-weight:700;color:var(--fg);margin-bottom:3px;letter-spacing:-.4px}
.spkph{font-family:'JetBrains Mono',monospace;font-size:.82rem;color:var(--accent2);margin-bottom:2px}
.spkm{font-size:.78rem;color:var(--muted)}
.spkctx{margin-top:8px;font-size:.78rem;color:#6a80a0;font-style:italic}
.lmod{padding:6px 12px;background:transparent;border:1px solid var(--accent2);border-radius:6px;color:var(--accent2);font-family:'Space Grotesk',sans-serif;font-size:.74rem;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:4px;margin-top:8px}
.lmod:hover{background:rgba(0,188,212,.06)}
.mbtn{width:66px;height:66px;border-radius:50%;border:2px solid var(--accent);background:var(--adim);color:var(--accent);font-size:1.6rem;cursor:pointer;transition:all .3s;margin:.75rem auto;display:flex;align-items:center;justify-content:center}
.mbtn:hover{background:rgba(0,230,118,.15);transform:scale(1.05)}
.mbtn.rec{background:var(--accent);color:var(--bg);animation:mpulse 1s ease infinite}
@keyframes mpulse{0%,100%{box-shadow:0 0 0 0 rgba(0,230,118,.3)}50%{box-shadow:0 0 0 16px rgba(0,230,118,0)}}
.rres{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1rem;margin-top:.75rem;display:none}
.rres.show{display:block;animation:fi .3s}
.rres .rl2{font-size:.6rem;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:4px}
.rres .rt2{font-size:1rem;font-weight:500;color:var(--fg);margin-bottom:6px}
.mind{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:14px;font-size:.72rem;font-weight:600}
.mind.mg{background:var(--sdim);color:var(--suc)}.mind.mp{background:var(--wdim);color:var(--wrn)}.mind.mr{background:var(--edim);color:var(--err)}
.wnav{display:flex;justify-content:center;align-items:center;gap:.6rem;margin-bottom:.75rem}
.wnav button{width:32px;height:32px;border-radius:50%;border:1px solid var(--border);background:var(--card);color:var(--fg);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;font-size:.75rem}
.wnav button:hover{border-color:var(--accent);color:var(--accent)}

/* Chat */
.chcont{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.chtopics{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px;padding:.75rem;border-bottom:1px solid var(--border)}
.tcard{background:var(--card2);border:1px solid var(--border);border-radius:8px;padding:.75rem;cursor:pointer;transition:all .25s}
.tcard:hover{border-color:var(--accent);transform:translateY(-1px)}
.tcard.at{border-color:var(--accent);background:var(--adim)}
.tcard h4{font-size:.8rem;color:var(--fg);margin-bottom:3px;display:flex;align-items:center;gap:5px}
.tcard p{font-size:.66rem;color:var(--muted);line-height:1.3}
.tlvl{font-family:'JetBrains Mono',monospace;font-size:.55rem;padding:1px 5px;border-radius:3px;background:var(--adim);color:var(--accent);font-weight:600}
.chmsgs{max-height:300px;overflow-y:auto;padding:.75rem;display:flex;flex-direction:column;gap:8px}
.cmsg{display:flex;gap:6px;max-width:88%;animation:fi .3s}
.cmsg.ai{align-self:flex-start}.cmsg.usr{align-self:flex-end;flex-direction:row-reverse}
.cav{width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:.75rem
