const rdD={
A1:[{title:"Parts of a Computer",text:`A computer has many <span class="vh" data-word="parts" data-def="partes - componentes">parts</span>. The <span class="vh" data-word="screen" data-def="pantalla - muestra imagenes">screen</span> shows pictures. The <span class="vh" data-word="keyboard" data-def="teclado - para escribir">keyboard</span> has letters. You use the <span class="vh" data-word="mouse" data-def="raton - para hacer clic">mouse</span> to click. The <span class="vh" data-word="processor" data-def="procesador - cerebro del PC">processor</span> is the brain. A <span class="vh" data-word="printer" data-def="impresora - copias en papel">printer</span> makes paper copies. Computers need <span class="vh" data-word="electricity" data-def="electricidad - energia">electricity</span> to work.`,q:[{qt:"What does the screen do?",o:["Prints paper","Shows pictures","Types letters","Saves files"],c:1,fb:"La pantalla muestra imagenes."},{qt:"What is the processor?",o:["A printer","The brain","A mouse","A screen"],c:1,fb:"El procesador es el cerebro."},{qt:"What does a printer do?",o:["Paper copies","Shows pictures","Clicks things","Provides electricity"],c:0,fb:"Hace copias en papel."},{qt:"What do computers need?",o:["Water","Electricity","Paper","Sunlight"],c:1,fb:"Necesitan electricidad."}]}],
A2:[{title:"What Is the Internet of Things?",text:`The Internet of Things, or <span class="vh" data-word="IoT" data-def="Internet de las Cosas">IoT</span>, is a system of connected devices. A <span class="vh" data-word="smart thermostat" data-def="termostato inteligente">smart thermostat</span> learns when you are home. A <span class="vh" data-word="wearable" data-def="dispositivo que se lleva puesto">wearable</span> like a smartwatch counts your steps. In a <span class="vh" data-word="smart home" data-def="hogar inteligente">smart home</span>, lights turn off automatically. Farmers use IoT <span class="vh" data-word="sensors" data-def="sensores - detectan cambios">sensors</span> to measure water. However, <span class="vh" data-word="hackers" data-def="hackers - acceden sin permiso">hackers</span> might try to access devices. That is why <span class="vh" data-word="cybersecurity" data-def="ciberseguridad">cybersecurity</span> is important.`,q:[{qt:"What does IoT stand for?",o:["Internet of Things","Internet of Transfers","Internal Operating Tech","Interconnected Objects"],c:0,fb:"Internet of Things."},{qt:"What can a smart thermostat do?",o:["Make calls","Adjust temperature","Cook food","Connect to printer"],c:1,fb:"Ajusta la temperatura automaticamente."},{qt:"Why is cybersecurity important?",o:["Faster devices","Cheaper cost","Hackers might access devices","Better WiFi"],c:2,fb:"Los hackers pueden acceder."},{qt:"How do farmers use IoT?",o:["Count animals","Measure water in soil","Drive tractors","Sell online"],c:1,fb:"Sensan agua en la tierra."}]}],
B1:[{title:"CRISPR: Editing the Code of Life",text:`<span class="vh" data-word="CRISPR" data-def="tecnologia de edicion genetica">CRISPR</span> allows scientists to edit <span class="vh" data-word="DNA" data-def="acido desoxirribonucleico">DNA</span> with precision. Discovered in <span class="vh" data-word="bacteria" data-def="bacterias - microorganismos">bacteria</span> as a defense mechanism, it was adapted by Doudna and Charpentier, who won the Nobel Prize in Chemistry 2020.\n\nThe system works like molecular scissors. A <span class="vh" data-word="guide RNA" data-def="ARN guia - dirige la edicion">guide RNA</span> leads the <span class="vh" data-word="Cas9" data-def="proteina que corta ADN">Cas9</span> protein to a specific location. Scientists can remove, add, or replace <span class="vh" data-word="genetic material" data-def="material genetico">genetic material</span>.\n\nApplications include treating <span class="vh" data-word="genetic disorders" data-def="enfermedades geneticas">genetic disorders</span>, creating <span class="vh" data-word="disease-resistant" data-def="resistente a enfermedades">disease-resistant</span> crops. Ethical concerns remain, especially regarding <span class="vh" data-word="germline editing" data-def="edicion heredable">germline editing</span>.`,q:[{qt:"Where was CRISPR discovered?",o:["Laboratory","Bacteria","Plants","Human cells"],c:1,fb:"En bacterias."},{qt:"What role does guide RNA play?",o:["Cuts DNA","Leads Cas9 to target","Creates new DNA","Protects cell"],c:1,fb:"Dirige Cas9 al blanco."},{qt:"Why is germline editing controversial?",o:["Expensive","Changes inherited by future generations","Uses too much energy","Only in bacteria"],c:1,fb:"Los cambios se heredan."},{qt:"Who won the Nobel for CRISPR?",o:["Curie & Franklin","Doudna & Charpentier","Watson & Crick","Einstein & Bohr"],c:1,fb:"Doudna y Charpentier, Nobel 2020."}]}],
B2:[{title:"Quantum Computing: Beyond Binary",text:`Classical computers use <span class="vh" data-word="bits" data-def="0 o 1">bits</span>. <span class="vh" data-word="Quantum computers" data-def="ordenadores cuanticos">Quantum computers</span> use <span class="vh" data-word="qubits" data-def="bits cuanticos">qubits</span>, which can exist in <span class="vh" data-word="superposition" data-def="0 y 1 simultaneamente">superposition</span>. Combined with <span class="vh" data-word="entanglement" data-def="conexion cuantica">entanglement</span>, this allows parallel processing.\n\nApplications: breaking <span class="vh" data-word="encryption" data-def="cifrado">encryption</span>, simulating <span class="vh" data-word="molecular structures" data-def="estructuras moleculares">molecular structures</span>, optimizing <span class="vh" data-word="logistics" data-def="logistica">logistics</span>.\n\nHowever, <span class="vh" data-word="decoherence" data-def="perdida cuantica">decoherence</span> causes qubits to lose quantum properties. This requires extreme cold and <span class="vh" data-word="error correction" data-def="correccion de errores">error correction</span>. Researchers aim for <span class="vh" data-word="fault-tolerant" data-def="tolerante a fallos">fault-tolerant</span> computing.`,q:[{qt:"Key difference between bits and qubits?",o:["Qubits smaller","Qubits: superposition","Bits faster","Bits use less energy"],c:1,fb:"Superposicion."},{qt:"What causes decoherence?",o:["Software bugs","Environment interaction","Low power","Too many calculations"],c:1,fb:"Interaccion con el entorno."},{qt:"NOT mentioned as quantum application?",o:["Encryption","Drug discovery","Weather forecasting","Logistics"],c:2,fb:"No se menciona clima."},{qt:"What does fault-tolerant mean?",o:["Never errors","Works even with errors","High temperatures","Classical bits"],c:1,fb:"Funciona con errores presentes."}]}],
C1:[{title:"Neuromorphic Engineering",text:`<span class="vh" data-word="Neuromorphic engineering" data-def="computacion inspirada en cerebro">Neuromorphic engineering</span> replicates neural systems in silicon. Unlike <span class="vh" data-word="von Neumann" data-def="memoria y procesador separados">von Neumann</span> architecture—creating the <span class="vh" data-word="bottleneck" data-def="cuello de botella">bottleneck</span>—neuromorphic chips integrate <span class="vh" data-word="synaptic weights" data-def="pesos sinapticos">synaptic weights</span> and <span class="vh" data-word="spiking neurons" data-def="neuronas de disparo">spiking neurons</span> co-located.\n\nThis <span class="vh" data-word="co-localization" data-def="en el mismo lugar">co-localization</span> reduces energy drastically. Intel's Loihi 2 consumes microwatts per <span class="vh" data-word="inference" data-def="inferencia">inference</span>. The <span class="vh" data-word="asynchronous" data-def="sin reloj global">asynchronous</span> nature eliminates global clocks.\n\nTraining challenges persist: <span class="vh" data-word="backpropagation" data-def="propagacion hacia atras">backpropagation</span> doesn't map to <span class="vh" data-word="spike-based" data-def="basado en pulsos">spike-based</span> computation. <span class="vh" data-word="Surrogate gradient" data-def="gradiente sustituto">Surrogate gradient</span> methods and <span class="vh" data-word="STDP" data-def="plasticidad por tiempo de disparo">STDP</span> aim to enable <span class="vh" data-word="on-chip learning" data-def="aprendizaje en chip">on-chip learning</span>.`,q:[{qt:"What problem does neuromorphic address?",o:["Quantum decoherence","Von Neumann bottleneck","Solar efficiency","CRISPR off-target"],c:1,fb:"El cuello de botella de von Neumann."},{qt:"Why does co-localization save energy?",o:["Smaller transistors","Minimizes data movement","No electricity","Quantum tunneling"],c:1,fb:"Reduce movimiento de datos."},{qt:"Training challenge?",o:["Insufficient data","Backprop doesn't map to spikes","Too much memory","Overheating"],c:1,fb:"Backprop no se adapta."},{qt:"What does STDP stand for?",o:["Short-Term Data Processing","Spike-Timing-Dependent Plasticity","Systematic Training","Synchronous Protocol"],c:1,fb:"Spike-Timing-Dependent Plasticity."}]}],
C2:[{title:"Epigenetic Landscape",text:`The <span class="vh" data-word="epigenome" data-def="capa regulatoria sobre ADN">epigenome</span> modulates gene expression without altering the <span class="vh" data-word="nucleotide sequence" data-def="secuencia de bases">nucleotide sequence</span>. <span class="vh" data-word="DNA methylation" data-def="metilacion del ADN">DNA methylation</span>, <span class="vh" data-word="histone modification" data-def="modificacion de histonas">histone modifications</span>, and <span class="vh" data-word="chromatin remodeling" data-def="remodelado de cromatina">chromatin remodeling</span> govern <span class="vh" data-word="transcriptional accessibility" data-def="accesibilidad para lectura">transcriptional accessibility</span>.\n\nWaddington's <span class="vh" data-word="epigenetic landscape" data-def="metafora de rutas de desarrollo">epigenetic landscape</span> captures how <span class="vh" data-word="pluripotent" data-def="capaz de diferenciarse">pluripotent</span> cells navigate <span class="vh" data-word="lineage commitments" data-def="compromisos de linaje">lineage commitments</span>. <span class="vh" data-word="single-cell multi-omics" data-def="multi-omicas de celula unica">Single-cell multi-omics</span> reveals <span class="vh" data-word="stochastic" data-def="con componente aleatorio">stochastic</span> transitions governed by <span class="vh" data-word="probabilistic epigenetic drift" data-def="deriva epigenetica probabilistica">probabilistic epigenetic drift</span>.\n\n<span class="vh" data-word="Epigenetic drugs" data-def="farmacos epigeneticos">Epigenetic drugs</span> can reactivate <span class="vh" data-word="tumor suppressor genes" data-def="genes supresores de tumores">tumor suppressor genes</span>. However, <span class="vh" data-word="pleiotropic effects" data-def="efectos multiples">pleiotropic effects</span> demand exquisite <span class="vh" data-word="specificity" data-def="especificidad">specificity</span>, as <span class="vh" data-word="demethylation" data-def="desmetilacion">demethylation</span> at <span class="vh" data-word="imprinted loci" data-def="loci imputados">imprinted loci</span> could trigger <span class="vh" data-word="oncogenic translocation" data-def="translocacion oncogenica">oncogenic translocation</span>.`,q:[{qt:"What does the epigenome modulate without changing?",o:["Protein folding","Nucleotide sequence","Cell membrane","Mitochondrial DNA"],c:1,fb:"Modula sin alterar la secuencia."},{qt:"What does Waddington's landscape describe?",o:["Protein folding","Cell differentiation routes","Neural training","Quantum transitions"],c:1,fb:"Rutas de diferenciacion."},{qt:"What did multi-omics reveal?",o:["Deterministic","Stochastic drift","Irreversible","Linear"],c:1,fb:"Transiciones estocasticas."},{qt:"Why is specificity critical for epigenetic drugs?",o:["Too expensive","Demethylation could trigger translocation","Patient immunity","Only in vitro"],c:1,fb:"Podria causar translocacion oncogenica."}]}]
};

