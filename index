// ============ UTILIDADES ============
function toast(m,t='i'){const c=document.getElementById('toastC'),e=document.createElement('div');e.className='toast '+(t==='s'?'ts':t==='e'?'te':'ti2');e.innerHTML=`<i class="fas fa-${t==='s'?'check-circle':t==='e'?'exclamation-circle':'info-circle'}"></i> ${m}`;c.appendChild(e);setTimeout(()=>e.remove(),3000)}
function us(){document.getElementById('strk').textContent=S.streak;document.getElementById('xpD').textContent=S.xp;document.getElementById('corD').textContent=S.correct}
function axp(n){S.xp+=n;us()}
function lev(a,b){const m=[];for(let i=0;i<=b.length;i++)m[i]=[i];for(let j=0;j<=a.length;j++)m[0][j]=j;for(let i=1;i<=b.length;i++)for(let j=1;j<=a.length;j++)m[i][j]=b[i-1]===a[j-1]?m[i-1][j-1]:Math.min(m[i-1][j-1]+1,m[i][j-1]+1,m[i-1][j]+1);return m[b.length][a.length]}
function shuf(a){const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b}
function spk(t,r=.9){synthX.cancel();const u=new SpeechSynthesisUtterance(t);u.lang='en-US';u.rate=r;const v=synthX.getVoices().find(x=>x.lang.startsWith('en'));if(v)u.voice=v;synthX.speak(u)}
function bds(id,levels,cb){const el=document.getElementById(id);el.innerHTML='';levels.forEach(l=>{const b=document.createElement('button');b.className='db'+(l===levels[0]?' on':'');b.textContent=l;b.onclick=()=>{el.querySelectorAll('.db').forEach(x=>x.classList.remove('on'));b.classList.add('on');cb(l)};el.appendChild(b)})}

// Tabs
document.querySelectorAll('.tb').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tb').forEach(x=>x.classList.remove('on'));document.querySelectorAll('.pnl').forEach(x=>x.classList.remove('on'));b.classList.add('on');document.getElementById('p-'+b.dataset.t).classList.add('on')});
document.querySelectorAll('.stab').forEach(b=>b.onclick=()=>{const p=b.closest('.pnl');p.querySelectorAll('.stab').forEach(x=>x.classList.remove('on'));p.querySelectorAll('.scont').forEach(x=>x.classList.remove('on'));b.classList.add('on');document.getElementById('s-'+b.dataset.s).classList.add('on')});

// Tooltip
document.addEventListener('mouseover',e=>{if(e.target.classList.contains('vh')){const t=document.getElementById('vtt');t.querySelector('.vw').textContent=e.target.dataset.word;t.querySelector('.vd').textContent=e.target.dataset.def;t.classList.add('show');const r=e.target.getBoundingClientRect();t.style.top=(r.bottom+8)+'px';t.style.left=Math.min(r.left,window.innerWidth-260)+'px'}});
document.addEventListener('mouseout',e=>{if(e.target.classList.contains('vh'))document.getElementById('vtt').classList.remove('show')});

// ============ PRACTICA: GAP ============
function loadGap(){const d=gapD[S.prLv]||gapD.A1;const ds=shuf(d);const a=document.getElementById('gapA');a.innerHTML='';ds.slice(0,4).forEach((g,i)=>{const parts=g.s.split('___');a.innerHTML+=`<div class="qc" id="gq${i}"><div class="qn">Gap ${i+1}</div><div class="gap-s">${parts[0]}<input class="gi" id="gip${i}" placeholder="${g.h}" autocomplete="off">${parts[1]||''}</div><div class="qfb" id="gfb${i}"></div></div>`})}
document.getElementById('chkGap').onclick=()=>{const d=gapD[S.prLv]||gapD.A1;const ds=shuf(d);let cc=0;ds.slice(0,4).forEach((g,i)=>{const inp=document.getElementById('gip'+i);const fb=document.getElementById('gfb'+i);const card=document.getElementById('gq'+i);const v=inp.value.trim().toLowerCase();if(v===g.a.toLowerCase()){cc++;inp.classList.add('ok');card.classList.add('ok');fb.className='qfb show fok';fb.innerHTML=`<i class="fas fa-check-circle"></i> Correcto!`}else{inp.classList.add('no');card.classList.add('no');fb.className='qfb show fno';fb.innerHTML=`<i class="fas fa-times-circle"></i> Respuesta: <strong>${g.a}</strong>`}});const xp=cc*12;S.correct+=cc;S.streak=cc>=3?S.streak+1:0;axp(xp);toast(`Gaps: ${cc}/4 (+${xp} XP)`,cc>=3?'s':'i')};
document.getElementById('newGap').onclick=()=>{loadGap()};

// ============ PRACTICA: MATCHING ============
function loadMatch(){const d=matchD[S.prLv]||matchD.A1;const pairs=d[0].p;const a=document.getElementById('matchA');S.mtSel=null;S.mtDone=0;const leftI=shuf(pairs.map((p,i)=>({...p,idx:i,side:'left'})));const rightI=shuf(pairs.map((p,i)=>({...p,idx:i,side:'right'})));a.innerHTML=`<div class="mgrid"><div class="mcol" id="ml">${leftI.map(it=>`<div class="mitem" data-i="${it.idx}" data-s="left">${it.l}</div>`).join('')}</div><div class="mcol" id="mr">${rightI.map(it=>`<div class="mitem" data-i="${it.idx}" data-s="right">${it.r}</div>`).join('')}</div></div>`;a.querySelectorAll('.mitem').forEach(el=>el.onclick=()=>{if(el.classList.contains('done'))return;if(!S.mtSel){S.mtSel={i:el.dataset.i,s:el.dataset.s,el};el.classList.add('sel')}else{if(S.mtSel.s===el.dataset.s){S.mtSel.el.classList.remove('sel');el.classList.add('sel');S.mtSel={i:el.dataset.i,s:el.dataset.s,el}}else{if(S.mtSel.i===el.dataset.i){S.mtSel.el.classList.remove('sel');S.mtSel.el.classList.add('done');el.classList.remove('sel');el.classList.add('done');S.mtDone++;S.correct++;axp(8);if(S.mtDone===pairs.length){toast(`Matching completo! (+${S.mtDone*8} XP)`,'s');document.getElementById('chkMt').disabled=true}}else{S.mtSel.el.classList.add('wm');el.classList.add('wm');const ref=S.mtSel.el;setTimeout(()=>{ref.classList.remove('wm','sel');el.classList.remove('wm')},500)}S.mtSel=null}}});document.getElementById('chkMt').disabled=false}
document.getElementById('chkMt').onclick=()=>{toast(`${S.mtDone} pares emparejados`,'s')};
document.getElementById('newMt').onclick=()=>{loadMatch()};

// ============ PRACTICA: TRUE/FALSE ============
function loadTf(){const d=tfD[S.prLv]||tfD.A1;const ds=shuf(d);const a=document.getElementById('tfA');a.innerHTML='';ds.slice(0,4).forEach((t,i)=>{a.innerHTML+=`<div class="qc" id="tq${i}"><div class="qn">Statement ${i+1}</div><div class="qt">${t.st}</div><div class="tf-g"><button class="tfb" data-q="${i}" data-v="true"><i class="fas fa-check"></i> True</button><button class="tfb" data-q="${i}" data-v="false"><i class="fas fa-times"></i> False</button></div><div class="qfb" id="tfb${i}"></div></div>`});a.querySelectorAll('.tfb').forEach(b=>b.onclick=()=>{const qi=b.dataset.q;a.querySelectorAll(`.tfb[data-q="${qi}"]`).forEach(x=>x.classList.remove('sel'));b.classList.add('sel')})}
document.getElementById('chkTf').onclick=()=>{const d=tfD[S.prLv]||tfD.A1;const ds=shuf(d);let cc=0;ds.slice(0,4).forEach((t,i)=>{const card=document.getElementById('tq'+i);const fb=document.getElementById('tfb'+i);const sel=card.querySelector('.tfb.sel');const fv=sel?sel.dataset.v==='true':null;card.querySelectorAll('.tfb').forEach(b=>b.classList.add('dis'));card.querySelector(`.tfb[data-v="${t.a}"]`).classList.add('cat');if(fv===t.a){cc++;card.classList.add('ok');fb.className='qfb show fok';fb.innerHTML=`<i class="fas fa-check-circle"></i> ${t.fb}`}else{if(sel)sel.classList.add('wat');card.classList.add('no');fb.className='qfb show fno';fb.innerHTML=`<i class="fas fa-times-circle"></i> ${t.fb}`}});const xp=cc*12;S.correct+=cc;S.streak=cc>=3?S.streak+1:0;axp(xp);toast(`True/False: ${cc}/4 (+${xp} XP)`,cc>=3?'s':'i')};
document.getElementById('newTf').onclick=()=>{loadTf()};

// ============ PRACTICA: SHORT ANSWER ============
function loadSa(){const d=saD[S.prLv]||saD.A1;const ds=shuf(d);const a=document.getElementById('saA');a.innerHTML='';ds.slice(0,3).forEach((s,i)=>{a.innerHTML+=`<div class="qc" id="sq${i}"><div class="qn">Question ${i+1}</div><div class="qt">${s.q}</div><input class="sai" id="sip${i}" placeholder="Type your answer..." autocomplete="off"><div class="qfb" id="sfb${i}"></div></div>`})}
document.getElementById('chkSa').onclick=()=>{const d=saD[S.prLv]||saD.A1;const ds=shuf(d);let cc=0;ds.slice(0,3).forEach((s,i)=>{const card=document.getElementById('sq'+i);const inp=document.getElementById('sip'+i);const fb=document.getElementById('sfb'+i);const v=inp.value.trim().toLowerCase();const ok=v===s.a.toLowerCase()||s.al.some(a=>a.toLowerCase()===v)||lev(v,s.a.toLowerCase())<=2;if(ok){cc++;card.classList.add('ok');fb.className='qfb show fok';fb.innerHTML=`<i class="fas fa-check-circle"></i> Correcto!`}else{card.classList.add('no');fb.className='qfb show fno';fb.innerHTML=`<i class="fas fa-times-circle"></i> Respuesta: <strong>${s.a}</strong>. ${s.fb}`}});const xp=cc*15;S.correct+=cc;axp(xp);toast(`Short Answer: ${cc}/3 (+${xp} XP)`,cc>=2?'s':'i')};
document.getElementById('newSa').onclick=()=>{loadSa()};

// ============ PRACTICA: SCRAMBLE ============
function loadScr(){const words=scrD[S.prLv]||scrD.A1;const w=words[Math.floor(Math.random()*words.length)];S.scrAnswer=w.toUpperCase();const letters=shuf(w.toUpperCase().split(''));const a=document.getElementById('scrA');a.innerHTML=`<div style="text-align:center;margin-bottom:.75rem"><button class="dplay" onclick="spk('${w}',0.7)"><i class="fas fa-volume-up"></i></button><p style="font-size:.72rem;color:var(--muted);margin-top:4px">Escucha la palabra</p></div><div class="scr-w" id="scrLs">${letters.map((l,i)=>`<div class="scr-l" data-i="${i}">${l}</div>`).join('')}</div><div class="scr-a" id="scrAn">${w.split('').map(()=>'<div class="scr-sl"></div>').join('')}</div><p style="text-align:center;font-size:.78rem;color:var(--muted)" id="scrFb"></p>`;let placed=[];const slots=a.querySelectorAll('.scr-sl');const ltrs=a.querySelectorAll('.scr-l');ltrs.forEach(l=>l.onclick=()=>{if(l.classList.contains('pl'))return;l.classList.add('pl');placed.push({letter:l.textContent,el:l});const si=placed.length-1;if(si<slots.length){slots[si].textContent=l.textContent;slots[si].classList.add('fil')}if(placed.length===w.length){const guess=placed.map(p=>p.letter).join('');if(guess===w.toUpperCase()){S.correct++;axp(12);document.getElementById('scrFb').innerHTML=`<span style="color:var(--ok)"><i class="fas fa-check-circle"></i> Correcto! "${w}"</span>`;toast('Palabra correcta! +12 XP','s')}else{document.getElementById('scrFb').innerHTML=`<span style="color:var(--no)"><i class="fas fa-times-circle"></i> Incorrecto. Era "${w}".</span>`;setTimeout(()=>{placed=[];slots.forEach(s=>{s.textContent='';s.classList.remove('fil')});ltrs.forEach(l=>l.classList.remove('pl'))},1500)}}})}
document.getElementById('newScr').onclick=()=>loadScr();

// ============ PRACTICA: DICTATION ============
let curDict='';
function loadDict(){const d=dictD[S.prLv]||dictD.A1;curDict=d[Math.floor(Math.random()*d.length)];const a=document.getElementById('dictA');a.innerHTML=`<div class="dbox"><div style="display:flex;align-items:center;gap:12px;margin-bottom:10px"><button class="dplay" onclick="spk(curDict,.75)"><i class="fas fa-play"></i></button><p style="font-size:.84rem;color:var(--muted)">Escucha y escribe lo que oyes</p></div><textarea class="sai" id="dtInp" rows="3" placeholder="Type what you hear..." style="min-height:70px;resize:vertical"></textarea><div id="dtFb" style="margin-top:8px"></div></div>`}
document.getElementById('chkDt').onclick=()=>{const inp=document.getElementById('dtInp');const fb=document.getElementById('dtFb');const v=inp.value.trim();if(!v){toast('Escribe algo primero','e');return}const clean=curDict.replace(/[.,!?]/g,'').toLowerCase();const vc=v.replace(/[.,!?]/g,'').toLowerCase();const dist=lev(vc,clean);const maxLen=Math.max(clean.length,1);const pct=Math.round((1-dist/maxLen)*100);if(pct>=90){fb.innerHTML=`<div style="color:var(--ok);font-size:.84rem"><i class="fas fa-check-circle"></i> Excelente! ${pct}% similar</div><p style="color:var(--muted);font-size:.75rem;margin-top:4px">${curDict}</p>`;S.correct++;axp(15)}else if(pct>=60){fb.innerHTML=`<div style="color:var(--wr);font-size:.84rem"><i class="fas fa-exclamation-triangle"></i> Casi! ${pct}% similar</div><p style="color:var(--muted);font-size:.75rem;margin-top:4px">${curDict}</p>`;axp(5)}else{fb.innerHTML=`<div style="color:var(--no);font-size:.84rem"><i class="fas fa-times-circle"></i> ${pct}% similar. Intenta de nuevo.</div>`}};
document.getElementById('newDt').onclick=()=>{loadDict()};

bds('prDS',LV,l=>{S.prLv=l;loadGap();loadMatch();loadTf();loadSa();loadScr();loadDict()});

// ============ COMPRENSIÓN ESCRITA ============
function loadRd(){const d=rdD[S.rdLv][S.rdIdx%rdD[S.rdLv].length];document.getElementById('rdP').innerHTML=`<h3 style="margin-bottom:8px;color:var(--em);font-size:.95rem;font-weight:700">${d.title}</h3>`+d.text.replace(/\n/g,'<br><br>');const q=document.getElementById('rdQ');q.innerHTML='';S.rdAns={};document.getElementById('chkRd').disabled=true;document.getElementById('rdR').classList.remove('show');d.q.forEach((qs,i)=>{const c=document.createElement('div');c.className='qc';c.id='rq'+i;c.innerHTML=`<div class="qn">Q${i+1}</div><div class="qt">${qs.qt}</div><div class="qops">${qs.o.map((o,j)=>`<button class="qo" data-q="${i}" data-o="${j}">${o}</button>`).join('')}</div><div class="qfb" id="rqf${i}"></div>`;q.appendChild(c)});q.querySelectorAll('.qo').forEach(b=>b.onclick=()=>{const qi=+b.dataset.q;q.querySelectorAll(`.qo[data-q="${qi}"]`).forEach(x=>x.classList.remove('sel'));b.classList.add('sel');S.rdAns[qi]=+b.dataset.o;document.getElementById('chkRd').disabled=Object.keys(S.rdAns).length<d.q.length})}
document.getElementById('chkRd').onclick=()=>{const d=rdD[S.rdLv][S.rdIdx%rdD[S.rdLv].length];let cc=0;d.q.forEach((qs,i)=>{const card=document.getElementById('rq'+i),fb=document.getElementById('rqf'+i),opts=card.querySelectorAll('.qo'),ua=S.rdAns[i];opts.forEach(o=>o.classList.add('dis'));opts[qs.c].classList.add('ca');if(ua===qs.c){cc++;card.classList.add('ok');fb.className='qfb show fok';fb.innerHTML=`<i class="fas fa-check-circle"></i> ${qs.fb}`}else{if(ua!==undefined)opts[ua].classList.add('wa');card.classList.add('no');fb.className='qfb show fno';fb.innerHTML=`<i class="fas fa-times-circle"></i> ${qs.fb}`}});const t=d.q.length,pct=Math.round(cc/t*100),xp=cc*15;S.correct+=cc;S.streak=cc===t?S.streak+1:0;axp(xp);document.getElementById('rdSc').textContent=pct+'%';document.getElementById('rdC').textContent=cc;document.getElementById('rdI').textContent=t-cc;document.getElementById('rdX').textContent=xp;document.getElementById('rdR').classList.add('show');toast(`Comprension: ${cc}/${t} (+${xp} XP)`,cc===t?'s':'i')};
document.getElementById('newRd').onclick=()=>{S.rdIdx++;loadRd();toast('Nuevo texto','i')};
bds('rdDS',LV,l=>{S.rdLv=l;S.rdIdx=0;loadRd()});

// ============ COMPRENSIÓN ORAL: WORDS ============
function loadLw(){const sents=lwD[S.lsLv]||lwD.A1;const s=sents[S.lsIdx%sents.length];const a=document.getElementById('lwA');a.innerHTML=`<div class="lex"><div class="lsbox"><button class="dplay" onclick="spkLw()"><i class="fas fa-play"></i></button><div style="flex:1;font-size:.84rem;color:var(--muted)" id="lwRv">Pulsa play para escuchar</div></div><p style="font-size:.72rem;color:var(--muted);text-align:center;margin-bottom:.5rem">Selecciona las palabras que escuchaste:</p><div class="wgrid" id="lwG"></div><div class="lnav"><button onclick="S.lsIdx=Math.max(0,S.lsIdx-1);loadLw()"><i class="fas fa-chevron-left"></i></button><span class="lctr">${S.lsIdx%sents.length+1} / ${sents.length}</span><button onclick="S.lsIdx=Math.min(${sents.length-1},S.lsIdx+1);loadLw()"><i class="fas fa-chevron-right"></i></button></div></div>`;const g=document.getElementById('lwG');g.innerHTML='';shuf(s.w).forEach(w=>{const c=document.createElement('button');c.className='wchip';c.textContent=w;c.onclick=()=>c.classList.toggle('sel');g.appendChild(c)});document.getElementById('lwR').classList.remove('show')}
